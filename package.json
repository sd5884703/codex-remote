{
  "name": "codex-remote",
  "version": "0.1.0",
  "description": "编码遥控 — thin Remote I/O: phone voice/text ↔ local Codex",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node daemon/index.js",
    "dev": "node --watch daemon/index.js",
    "start:stub": "CODEX_REMOTE_STUB=1 node daemon/index.js",
    "install:always-on": "bash scripts/install-launch-agent.sh",
    "uninstall:always-on": "bash scripts/uninstall-launch-agent.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  }
}
